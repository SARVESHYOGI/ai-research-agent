#!/bin/sh
# Runs formatting + lint checks before every commit.
# Install once with: git config core.hooksPath .githooks

set -e

if ! uv run ruff format --check .; then
  echo
  echo "FAILED: formatting is wrong (e.g. bad indentation)."
  echo "Fix with:  uv run ruff format ."
  exit 1
fi

if ! uv run ruff check .; then
  echo
  echo "FAILED: lint errors detected."
  echo "Fix with:  uv run ruff check . --fix"
  exit 1
fi

if [ -d frontend/node_modules/.bin ]; then
  if ! (cd frontend && npx biome check .); then
    echo
    echo "FAILED: frontend formatting/lint errors detected."
    echo "Fix with:  cd frontend && npx biome check --write ."
    exit 1
  fi
fi

echo "ok: formatting + lint passed"