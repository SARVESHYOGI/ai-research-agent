# =====================================================================
# Redis — connection, caching and rate limiting.
# Managed by fastapi-redis-sdk (see app/core/redis). A single async
# connection pool is shared across the whole application.
# =====================================================================
REDIS_URL=redis://localhost:6379/0
# Alternatively configure individual fields (REDIS_URL takes precedence):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false
# REDIS_CLUSTER=false
# Global key prefix + default cache TTL (seconds, 0 = no expiry)
# REDIS_PREFIX=ai-research
# REDIS_DEFAULT_TTL=300
# Pool sizing / timeouts
# REDIS_MAX_CONNECTIONS=50
# REDIS_SOCKET_CONNECT_TIMEOUT=5

# =====================================================================
# Application (prefix: AI_RESEARCH_)
# =====================================================================
# AI_RESEARCH_APP_NAME=ai-research-agent
# AI_RESEARCH_VERSION=0.1.0
# PostgreSQL URL used by the health check (optional)
# AI_RESEARCH_DATABASE_URL=postgresql://ai:ai@localhost:5432/ai_research
# AI_RESEARCH_DATABASE_CHECK_TIMEOUT=5
