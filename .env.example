# =====================================================================
# Redis — connection, caching and rate limiting.
# Managed by fastapi-redis-sdk (see shared/redis). A single async
# connection pool is shared across all services.
# =====================================================================
REDIS_URL=redis://localhost:6379/0
# Alternatively configure individual fields (REDIS_URL takes precedence):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false
# REDIS_CLUSTER=false
# Global key prefix + default cache TTL (seconds, 0 = no expiry)
# REDIS_PREFIX=ai-research
# REDIS_DEFAULT_TTL=300
# Pool sizing / timeouts
# REDIS_MAX_CONNECTIONS=50
# REDIS_SOCKET_CONNECT_TIMEOUT=5

# =====================================================================
# API Gateway
# =====================================================================
# API_GATEWAY_APP_NAME=ai-research-agent
# PostgreSQL URL used by the gateway health check (optional)
# API_GATEWAY_DATABASE_URL=postgresql://ai:ai@localhost:5432/ai_research
# API_GATEWAY_DATABASE_CHECK_TIMEOUT=5
